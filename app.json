{
  "expo": {
    "name": "AthanNow",
    "slug": "AthanNow",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#17121F",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.bbabiker.AthanNow",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "AthanNow uses your location to calculate prayer times and the Qibla direction. You can search for a city instead."
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.security.application-groups": [
          "group.com.bbabiker.AthanNow"
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan.wav",
            "./assets/sounds/athan-medina.wav",
            "./assets/sounds/athan-egypt.wav",
            "./assets/sounds/athan-sudan.wav",
            "./assets/sounds/athan-almajd.wav"
          ]
        }
      ],
      "expo-font",
      [
        "react-native-widget-extension",
        {
          "frequentUpdates": false,
          "widgetsFolder": "widgets",
          "deploymentTarget": "16.4",
          "groupIdentifier": "group.com.bbabiker.AthanNow"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17121F"
        }
      ],
      "expo-image",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "0bdadb2f-1e94-4d6d-a8db-0ff6f5df3bf4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0bdadb2f-1e94-4d6d-a8db-0ff6f5df3bf4"
    }
  }
}
